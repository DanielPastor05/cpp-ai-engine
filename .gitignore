# CMake build directories and binaries
build*/
# The install prefix and the consumer build from the packaging test, which are
# produced by hand locally and fresh in CI. tests/package/ itself IS committed:
# it is the test.
_prefix/
_consumer/
bin/
out/
.vs/
CMakeCache.txt
CMakeFiles/
Makefile
*.cmake

# Archivos ejecutables y objetos
*.exe
*.obj
*.o
*.a
*.lib
*.dll
*.so
*.dylib

# Archivos de entorno e IDEs
.vscode/
.idea/
*.user
*.suo

# The PyTorch fixtures ARE committed: CI needs them and they are only 120 KB.
# tools/generate_reference.py regenerates them.
!tests/fixtures/*.bin

# Full MNIST: downloaded with tools/download_mnist.sh, never committed.
# The subset (subset-*) IS in the repository so that the examples
# funcionen recien clonado.
data/mnist/train-*
data/mnist/t10k-*
mnist_cnn.bin

# Local compilation database for clang-tidy: machine-specific absolute paths.
compile_commands.json

# The pinned lint tools, installed by the CI lint job and reproducible locally.
.lint/

# PyTorch, for tools/bench_pytorch.py. 2.5 GB of wheels; the benchmark says how
# to install it and CI never needs it.
.torch/

# Doxygen output, generated by CI and published to Pages.
doxygen-out/

# Python bytecode, from importing tools/claimcheck.py rather than running it.
__pycache__/
*.pyc

# Weight files the security tests craft in the working directory, to check the
# parser rejects them. tests/test_nn.cpp removes them on the way out, but only if
# it gets there -- a failing check throws past the cleanup, and running the suite
# from the repository root then leaves five files that `git add -A` will happily
# commit. Which is exactly what happened in e14722e, and they went out in v0.7.0.
hostile_*.bin
not_weights.bin

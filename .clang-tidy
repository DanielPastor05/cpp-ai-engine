# Comprobaciones de análisis estático.
#
# Se excluyen las que chocan con las convenciones del proyecto: nombres con
# guion bajo final, aritmética de punteros en los núcleos numéricos y números
# "mágicos" en las fórmulas.
#
# readability-braces-around-statements queda fuera a propósito. Los bucles de
# reducción se escriben en una línea —`for (size_t j = 0; j < D; ++j) mean +=
# row[j];`— y envolverlos en llaves triplicaría las líneas de las fórmulas sin
# hacerlas más claras.
Checks: >
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  modernize-use-override,
  modernize-use-nullptr,
  modernize-use-emplace,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -performance-avoid-endl
WarningsAsErrors: ''
HeaderFilterRegex: 'include/engine/.*'
